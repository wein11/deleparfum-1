---
import '../styles/global.css';

const WA_NUMBER = '5491139399189';
const WA_BASE   = `https://wa.me/${WA_NUMBER}`;

function waLink(name, size) {
  return `${WA_BASE}?text=${encodeURIComponent(`Hola! Quiero pedir ${name} ${size}`)}`;
}

function price(n) {
  return '$' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

const products = [
  { name: 'Afnan 9PM',                   slug: 'afnan-9pm',                  descriptor: 'Oriental · Amaderado',   p10: 9000,  p20: 16000 },
  { name: 'Lattafa Khamrah',             slug: 'lattafa-khamrah',             descriptor: 'Oriental · Especiado',   p10: 9000,  p20: 16000 },
  { name: 'Club de Nuit Intense Man EDT',slug: 'club-de-nuit-intense-man-edt',descriptor: 'Fougère · Amaderado',    p10: 9000,  p20: 16000, featured: true },
  { name: 'Lattafa Asad Yara',           slug: 'lattafa-asad-yara',           descriptor: 'Floral · Oriental',      p10: 9000,  p20: 16000 },
  { name: 'Lattafa Asad Yara Candy',     slug: 'lattafa-asad-yara-candy',     descriptor: 'Dulce · Gourmand',       p10: 9000,  p20: 16000 },
  { name: 'Lattafa Honor and Glory',     slug: 'lattafa-honor-and-glory',     descriptor: 'Amaderado · Especiado',  p10: 9000,  p20: 16000 },
  { name: 'French Avenue Liquid Brun',   slug: 'french-avenue-liquid-brun',   descriptor: 'Oriental · Amaderado',   p10: 12000, p20: 19000, featured: true },
  { name: 'Her Confession',             slug: 'her-confession',              descriptor: 'Floral · Almizclado',    p10: 12000, p20: 20000, ext: 'webp' },
  { name: 'Teriaq Intense',             slug: 'teriaq-intense',              descriptor: 'Oriental · Especiado',   p10: 12000, p20: 20000, ext: 'webp' },
];

const featured  = products.filter(p => p.featured);
const waGeneral = `${WA_BASE}?text=${encodeURIComponent('Hola! Quiero consultar sobre fragancias disponibles.')}`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Dele Parfum — Decants de fragancias de lujo en Argentina. Explorá los mejores perfumes del mundo en 10ml y 20ml." />
  <meta name="theme-color" content="#000000" />

  <meta property="og:title"       content="Dele Parfum — Fragancias de autor" />
  <meta property="og:description" content="Decants de perfumes de lujo. En tu medida." />
  <meta property="og:type"        content="website" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap"
    rel="stylesheet"
  />

  <title>Dele Parfum — Decants de Lujo</title>
</head>

<body>

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="hero" aria-label="Portada">

    <div class="hero-content">
      <img
        src="/assets/logo.png"
        alt="Dele Parfum"
        class="hero-logo"
        onerror="this.style.display='none';document.getElementById('logo-text').style.display='block';"
      />
      <p id="logo-text" class="hero-logo-text" style="display:none;">Dele Parfum</p>

      <p class="hero-eyebrow">Decants de autor &middot; Argentina</p>

      <h1 class="hero-headline">
        Fragancias<br />
        <em>de autor.</em>
      </h1>

      <div class="hero-divider" aria-hidden="true"></div>

      <p class="hero-tagline">
        Los mejores perfumes del mundo.<br />Sin necesitar el frasco completo.
      </p>
    </div>

    <div class="scroll-indicator" aria-hidden="true">
      <span class="scroll-indicator-label">Explorar</span>
      <div class="scroll-indicator-line"></div>
    </div>

  </section>

  <!-- ═══════════════════════ CONCEPTO ═══════════════════════════ -->
  <section class="concepto" aria-label="Qué es un decant">
    <div class="concepto-inner">
      <p class="concepto-label">¿Qué es un decant?</p>
      <p class="concepto-text">
        No necesitás comprar el frasco completo.<br />
        Explorá las <em>mejores fragancias del mundo</em><br />
        en 10&thinsp;ml o 20&thinsp;ml.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════ DESTACADOS ═════════════════════════ -->
  <section class="featured" aria-label="Productos destacados">

    <div class="featured-header">
      <p class="section-eyebrow">Selección especial</p>
      <h2 class="section-title">Los más elegidos</h2>
      <div class="section-divider" aria-hidden="true"></div>
    </div>

    {featured.map((p, i) => (
      <div class={`featured-item${i % 2 === 1 ? ' featured-item--reverse' : ''}`}>

        <div class="featured-image-wrap">
          <img
            src={`/assets/products/${p.slug}.${p.ext || 'jpg'}`}
            alt={`Frasco de ${p.name}`}
            class="featured-image"
            loading="lazy"
          />
        </div>

        <div class="featured-content">
          <span class="featured-badge">Destacado</span>
          <p class="featured-descriptor">{p.descriptor}</p>
          <h3 class="featured-name">{p.name}</h3>

          <div class="featured-options">
            <div>
              <span class="featured-option-label">10 ml</span>
              <span class="featured-option-price">{price(p.p10)}</span>
            </div>
            <div>
              <span class="featured-option-label">20 ml</span>
              <span class="featured-option-price">{price(p.p20)}</span>
            </div>
          </div>

          <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
            <a
              href={waLink(p.name, '10ml')}
              class="btn-wa-featured btn-magnetic"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Pedir ${p.name} 10ml por WhatsApp`}
            >
              <span>Pedir 10ml</span>
            </a>
            <a
              href={waLink(p.name, '20ml')}
              class="btn-wa-featured btn-magnetic"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Pedir ${p.name} 20ml por WhatsApp`}
            >
              <span>Pedir 20ml</span>
            </a>
          </div>
        </div>

      </div>
    ))}

  </section>

  <!-- ════════════════════════ CATÁLOGO ══════════════════════════ -->
  <section class="catalog" id="catalogo" aria-label="Catálogo de fragancias">
    <div class="section-header">
      <p class="section-eyebrow">Colección completa</p>
      <h2 class="section-title">Todos los decants</h2>
      <div class="section-divider" aria-hidden="true"></div>
    </div>

    <div class="catalog-grid">
      {products.map((p) => (
        <article class="product-card">

          <div class="card-image-wrap">
            <img
              src={`/assets/products/${p.slug}.${p.ext || 'jpg'}`}
              alt={`Frasco de ${p.name}`}
              class="card-image"
              loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            />
            <div class="card-image-fallback" aria-hidden="true">Próximamente</div>
          </div>

          <div class="card-body">
            <p class="card-descriptor">{p.descriptor}</p>
            <h3 class="card-name">{p.name}</h3>

            <div class="card-options">
              <div class="card-option">
                <span class="card-size-label">10 ml</span>
                <span class="card-price-value">{price(p.p10)}</span>
                <a
                  href={waLink(p.name, '10ml')}
                  class="btn-wa"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Pedir ${p.name} 10ml por WhatsApp`}
                >WhatsApp</a>
              </div>
              <div class="card-option">
                <span class="card-size-label">20 ml</span>
                <span class="card-price-value">{price(p.p20)}</span>
                <a
                  href={waLink(p.name, '20ml')}
                  class="btn-wa"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Pedir ${p.name} 20ml por WhatsApp`}
                >WhatsApp</a>
              </div>
            </div>
          </div>

        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════ WA CTA ════════════════════════════ -->
  <section class="wa-section" aria-label="Contacto por WhatsApp">
    <div class="wa-inner">
      <p class="wa-label">Atención personalizada</p>
      <h2 class="wa-headline">
        ¿No encontrás<br />lo que buscás?
      </h2>
      <p class="wa-subtext">Escribinos y lo conseguimos para vos.</p>
      <a
        href={waGeneral}
        class="btn-wa-main btn-magnetic"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
      >
        <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Escribinos por WhatsApp</span>
      </a>
    </div>
  </section>

  <!-- ══════════════════════════ FOOTER ══════════════════════════ -->
  <footer>
    <img
      src="/assets/logo.png"
      alt="Dele Parfum"
      class="footer-logo"
      onerror="this.style.display='none';document.getElementById('footer-logo-text').style.display='block';"
    />
    <p id="footer-logo-text" class="footer-logo-text" style="display:none;">Dele Parfum</p>

    <a
      href="https://instagram.com/deleparfum"
      class="footer-instagram"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram de Dele Parfum"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
      @deleparfum
    </a>

    <p class="footer-copy">
      Hecho con dedicación en Argentina
      <span class="footer-dot" aria-hidden="true"></span>
      Dele Parfum &copy; 2025
    </p>
  </footer>

</body>
</html>

<script>
  import '../scripts/scroll-effects.js';
</script>
